{
  "name": "settlers",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.ts\" \"tests/host/*.test.ts\" \"tests/web_build/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "build": "node scripts/build-host.mjs && node scripts/build.mjs",
    "build:artifact": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs && mkdir -p web && cp dist/settlers.html web/settlers.html",
    "e2e": "node tests/e2e/run.mjs",
    "worker:dev": "npm run build && wrangler dev -c wrangler.toml -c tests/e2e/platform.wrangler.toml",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@napi-rs/canvas": "1.1.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "gl": "8.1.6",
    "jsdom": "30.1.3",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@app-builder/client-sdk": "file:platform/client-sdk",
    "@app-builder/host": "file:platform/host",
    "three": "0.187.0"
  },
  "overrides": {
    "node-gyp": "13.1.0",
    "tar": "7.5.22"
  }
}
